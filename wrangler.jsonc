{
  // Cloudflare Workers 專案設定。
  //
  // 若本專案改以 Cloudflare **Pages** 部署，這個檔案不會被使用，
  // 轉址走的是 functions/_middleware.js。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novapage",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",

  // 非機密設定。機密項目（GITHUB_TOKEN、ADMIN_PASSWORD_HASH、SESSION_SECRET）
  // 必須在 Cloudflare 的 Settings → Variables and Secrets 以 Secret 方式新增，
  // 不可寫在這裡，否則會進到版本庫。
  "vars": {
    "GITHUB_REPO": "novachemclaudecowork-a11y/novapage",
    "GITHUB_BRANCH": "claude/website-clone-assessment-x09jd5"
  },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // 一律先跑 worker/index.js。
    //
    // 預設（false）是先比對靜態資源，比不到才交給 Worker；但只要設了
    // not_found_handling，資源路由器就會自己回應找不到的請求，
    // Worker 永遠不會被呼叫，舊網址轉址因此全部失效。
    // 本機 wrangler dev 不會呈現這個差異，只有部署後才看得出來。
    "run_worker_first": true,

    // Worker 內呼叫 env.ASSETS.fetch() 後，找不到檔案時回傳
    // Astro 產生的 404 頁面
    "not_found_handling": "404-page"
  }
}
