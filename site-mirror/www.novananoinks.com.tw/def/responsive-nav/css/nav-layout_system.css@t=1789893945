@font-face {
  font-family: "icon-font";
  src: url('../fonts/icon-font.eot'); /* IE9 Compat Modes */
  src: url('../fonts/icon-font.eot?#iefix') format('embedded-opentype'), /* IE6-IE8 */
       url('../fonts/icon-font.woff2') format('woff2'), /* Super Modern Browsers */
       url('../fonts/icon-font.woff') format('woff'), /* Pretty Modern Browsers */
       url('../fonts/icon-font.ttf')  format('truetype'), /* Safari, Android, iOS */
       url('../fonts/icon-font.svg#svgFontName') format('svg'); /* Legacy iOS */
}
.icon-desktop:before,
.icon-menu-close:before,
.icon-menu:before,
.icon-mobile:before,
.icon-submenu-down:before,
.icon-submenu-right:before,
.icon-world:before,header h1:before,
.nav-button:before,
.nav-close:before,
table.HeaderBottomMenu {background-color:#24346C;}
.RwdMenu .nav-submenu > a:after,
.RwdMenu > ul > .nav-submenu > a:after {font-family: 'icon-font';-webkit-font-smoothing: antialiased;-moz-osx-font-smoothing: grayscale;font-style: normal;font-variant: normal;font-weight: normal;text-decoration: none;text-transform: none;vertical-align: top;}
.RwdMenu .nav-submenu li a{padding:0;}
.icon-desktop:before {content: '\E001';}
.icon-menu-close:before {content: '\E002';}
.icon-menu:before {content: '\E003';}
.icon-submenu-down:before {content: '\E005';}
.icon-submenu-right:before {content: '\E006';}
.icon-world:before {content: '\E007';}
body {padding-top: 42px;}
header {display: block;height:42px;position: fixed;top: 0;left: 0;right: 0;z-index: 901;padding-left: 10px;line-height: 42px;background: #1362AF;color: #FFFFFF;}
header h1 {height: 42px;margin: 0;font-size: 22px;line-height: 42px;color:#FFFFFF;text-align:left;overflow:hidden;}
.nav-button,a.nav-button:visited,a.nav-button:link,
.nav-close,a.nav-close:visited,a.nav-close:link {position: fixed;top: 1px;width: 36px;height: 40px;overflow: hidden;z-index: 902;cursor: pointer;text-decoration: none;line-height: 42px;background: #1362AF;color: #FFFFFF;}
.nav-button:before,
.nav-close:before {display: block;text-align: center;}
.nav-button {display: block;right: 1rem;font-size: 36px;}
.nav-button:before {content: '\E003';}
.nav-close {display: none;right: 4rem;font-size: 36px;}
.nav-close:before {content: '\E002';}
.RwdMenu {padding-top: 42px;background: #D1D1D1;color: #000000;}
.RwdMenu ul {background: #D1D1D1;text-align:Center}
.RwdMenu ul li{font-size:16px;font-weight:bold;;}
.RwdMenu ul ul {background: #D1D1D1;min-width:150px;border:1px #FFFFFF solid;}
.RwdMenu ul ul ul {background: #203C8A;}
.RwdMenu ul ul ul ul {background: #203C8A;}
.RwdMenu ul ul ul ul ul {background: #203C8A;}
.RwdMenu li {border-top: 1px solid #FFFFFF;}
.RwdMenu ul li:hover > a,
.RwdMenu ul li.nav-active > a {color: #FFFFFF;background: #203C8A;}
.RwdMenu ul ul li {font-size:16px;font-weight:bold;;}
.RwdMenu li {background-color: #1362AF;color: #FFFFFF;}
.RwdMenu ul ul li > a {background: #1362AF;color: #FFFFFF;}
.RwdMenu ul ul li:hover > a,
.RwdMenu ul ul li.nav-active > a {background: #0F4F8C;color: #FFFFFF;}
.RwdMenu .nav-submenu > ul {}
.RwdMenu a,
.RwdMenu a:hover,
.RwdMenu a:active,
.RwdMenu a:visited {background-color: #D1D1D1;color: #000000;text-decoration: none;}
.RwdMenu a{padding: 0;}
.RwdMenu font,.RwdMenu span{padding: 0 20px;}
@media screen and (min-width: 1202px) {
.RwdMenu .nav-submenu > a:after {display:none;margin:0;padding:0;width:0;}
.RwdMenu .nav-submenu > a {padding-right: 0 !important;}
.RwdHide {display:inline-block;}
.RwdMenu ul li a font {color: #FFFFFF;}
.RwdMenu ul li a font:hover {color: #FFFFFF;}
.RwdMenu span {display:none;}
}
@media screen and (max-width: 1201px) {
.DivTop{background:none;}
a.RwdWebName {display:inline-block;padding:0 55px 0 42px;font-size:22px;}
.RwdMenu .nav-submenu > a:after {position: absolute;display: block;right: 10px;top: 1px;content: '\E005';}
.RwdMenu .nav-submenu > a {padding-right: 30px !important;}
.RwdMenu a{padding: 0 10px;}
.RwdMenu ul li{float:none;}
.RwdMenu font,.RwdMenu span{padding: 0;}
.RwdHide {display:none;}
.RwdMenu img {display:none;}
.RwdMenu ul li span{line-height:42px;}
}
@media only screen and (max-width: 1001px) {
.RwdMenu {line-height: 42px;}
.RwdMenu .nav-submenu > ul {border:0;}
.RwdMenu ul li a{min-height:42px;font-size:16px;}
.RwdMenu ul li {float:none;}
.RwdMenu ul ul li {font-size:16px;font-weight:bold;;}
.RwdMenu ul ul li {background: #D1D1D1;color: #000000;}
.RwdMenu ul ul ul li {background: #D9D9D9;color: #000000;}
.RwdMenu ul ul li > a {background: #D9D9D9;color: #000000;}
.RwdMenu ul ul li:hover > a,
.RwdMenu ul ul li.nav-active > a {background: #203C8A;color: #FFFFFF;}
}
@media only screen and (min-width: 1002px) {
.RwdMenu {padding-top: 42px;background-color: #24346C;color: #FFFFFF;}
.RwdMenu ul {background-color: #24346C;}
.RwdMenu li *{font-size:16px;font-weight:bold;;}
.RwdMenu a,
.RwdMenu a:link,
.RwdMenu a:active,
.RwdMenu a:visited {background-color: #1362AF;color: #FFFFFF;text-decoration: none;}
.RwdMenu a:hover {background-color: #0F4F8C;color: #FFFFFF;text-decoration: none;}
.RwdMenu ul li:hover > a,
.RwdMenu ul li.nav-active > a {background-color: #0F4F8C;color: #FFFFFF;}
body {padding: 0 !important;}
header {position: relative;display:none;}
header h1:before {content: '\E001';}
.nav-button {display: none;}
.RwdMenu {padding: 0 !important;}
.RwdMenu > ul > li {border-top: none;line-height: 33px;vertical-align:middle;}
.RwdMenu ul ul ul {}
.RwdMenu ul li:first-child {border-top: none;}
.RwdMenu ul ul ul li:first-child {border-top: none;}
.RwdMenu .nav-left > ul {}
.RwdMenu .nav-submenu li {width: 100%;line-height: 23px;padding:5px;}
.RwdMenu .nav-submenu > ul {margin: 0;}
.RwdMenu > ul > .nav-submenu > a:after {content: '\E005';}
.RwdMenu .nav-submenu > a:after {content: '\E006';}
}
