---
// 後台登入頁。這是 /admin 底下唯一不需要登入就能開啟的頁面。
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>後台登入</title>
    <style>
      :root { --brand: #203c8a; --border: #dfe3ea; --text: #1c2027; --muted: #5a6473; }
      * { box-sizing: border-box; }
      body {
        margin: 0; min-height: 100vh; display: grid; place-items: center;
        background: #f5f7fa; color: var(--text); padding: 16px;
        font-family: system-ui, -apple-system, "Noto Sans TC", "PingFang TC",
                     "Microsoft JhengHei", sans-serif;
        line-height: 1.7;
      }
      .card {
        background: #fff; border: 1px solid var(--border); border-radius: 8px;
        padding: 32px; width: 100%; max-width: 24rem;
        box-shadow: 0 1px 3px rgb(28 32 39 / 8%), 0 8px 24px rgb(28 32 39 / 6%);
      }
      h1 { font-size: 1.125rem; margin: 0 0 4px; color: var(--brand); }
      .sub { font-size: .875rem; color: var(--muted); margin: 0 0 24px; }
      label { display: block; font-size: .875rem; font-weight: 600; margin-bottom: 6px; }
      input {
        width: 100%; padding: 11px 12px; font: inherit; color: var(--text);
        border: 1px solid var(--border); border-radius: 4px; background: #fff;
      }
      input:focus { outline: 2px solid var(--brand); outline-offset: -1px; }
      button {
        width: 100%; margin-top: 20px; padding: 12px; font: inherit; font-weight: 600;
        color: #fff; background: var(--brand); border: 0; border-radius: 4px; cursor: pointer;
      }
      button:hover:not(:disabled) { background: #162c66; }
      button:disabled { background: var(--muted); cursor: default; }
      .error {
        margin-top: 16px; padding: 10px 14px; border-radius: 4px; font-size: .875rem;
        background: #fdecef; border-inline-start: 4px solid #c8102e; color: #8a0b20;
      }
      .error[hidden] { display: none; }
    </style>
  </head>
  <body>
    <main class="card">
      <h1>貝星貿易　網站後台</h1>
      <p class="sub">請輸入後台密碼</p>

      <form id="login-form">
        <label for="password">密碼</label>
        <input id="password" name="password" type="password" required
               autocomplete="current-password" autofocus />
        <button type="submit" id="submit">登入</button>
      </form>

      <p class="error" id="error" hidden></p>
    </main>

    <script>
      const form = document.getElementById('login-form');
      const button = document.getElementById('submit');
      const error = document.getElementById('error');

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        error.hidden = true;
        button.disabled = true;
        button.textContent = '驗證中…';

        try {
          const res = await fetch('/admin/api/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ password: form.password.value }),
          });
          if (res.ok) {
            window.location.href = '/admin/';
            return;
          }
          const data = await res.json().catch(() => ({}));
          error.textContent = data.error ?? `登入失敗（${res.status}）`;
          error.hidden = false;
        } catch (e) {
          error.textContent = `連線失敗：${e.message}`;
          error.hidden = false;
        }

        button.disabled = false;
        button.textContent = '登入';
        form.password.select();
      });
    </script>
  </body>
</html>
