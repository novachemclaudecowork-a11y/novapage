---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { about, company } from '../data/site';

const paragraphs = about.body.split('\n').filter((line) => line.trim());
---

<BaseLayout title="公司簡介" description={company.description}>
  <Breadcrumb items={[{ label: '公司簡介' }]} />
  <h1>公司簡介</h1>

  {paragraphs.map((text, index) => (
    /* 最後一行是落款，靠右、不縮排，才看得出是署名而不是又一段內文 */
    <p class={index === paragraphs.length - 1 ? 'signature' : undefined}>{text}</p>
  ))}

  <h2>聯絡資訊</h2>
  <dl class="product-meta">
    <dt>公司名稱</dt><dd>{company.nameZh}</dd>
    <dt>英文名稱</dt><dd>{company.nameEn}</dd>
    <dt>地址</dt><dd>{company.address}</dd>
    <dt>電話</dt><dd><a href={`tel:${company.telHref}`}>{company.tel}</a></dd>
    <dt>傳真</dt><dd>{company.fax}</dd>
    <dt>信箱</dt><dd><a href={`mailto:${company.email}`}>{company.email}</a></dd>
  </dl>
</BaseLayout>
