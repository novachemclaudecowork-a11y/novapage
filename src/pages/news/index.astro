---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { news, plainText } from '../../data/site';
---

<BaseLayout title="最新訊息" description="貝星貿易最新消息與產品公告。">
  <Breadcrumb items={[{ label: '最新訊息' }]} />
  <h1>最新訊息</h1>

  {news.length > 0 ? (
    <ul class="news-list">
      {news.map((post) => (
        <li>
          <time datetime={post.date}>{post.date}</time>
          <a href={`/news/${post.slug}/`}>{post.title}</a>
          <p>{plainText(post.body).slice(0, 100)}</p>
        </li>
      ))}
    </ul>
  ) : (
    <p class="notice">目前沒有最新訊息。</p>
  )}
</BaseLayout>
