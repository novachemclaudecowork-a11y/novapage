---
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="麵包屑">
  <ol>
    <li><a href="/">首頁</a></li>
    {items.map((item) => (
      <li>{item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}</li>
    ))}
  </ol>
</nav>
