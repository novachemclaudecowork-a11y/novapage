---
/**
 * 大分類的線條圖示。
 *
 * 用內嵌 SVG 而非圖片檔：不會多一次請求，顏色跟著文字走（currentColor），
 * 放大也不會糊。側欄一次只有四個大分類，所以逐一指定、不做通用化。
 *
 * 後台新增分類時不會有對應圖示，那時退回通用的方塊，版面不會跑掉。
 */
interface Props { slug: string }
const { slug } = Astro.props;
---
<svg class="cat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
  {slug === 'screen-inks' && (
    /* 墨滴。18px 下也一眼認得出是油墨，和稀釋劑的瓶身不會混淆 */
    <path d="M12 3c3.2 3.9 6 7.2 6 10.3A6 6 0 0 1 6 13.3C6 10.2 8.8 6.9 12 3z" />
  )}
  {slug === 'thinners-cleaners' && (
    /* 溶劑瓶 */
    <>
      <path d="M10 2h4v3l3.2 4.4A4 4 0 0 1 18 12v7a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3v-7a4 4 0 0 1 .8-2.6L10 5z" />
      <path d="M6.3 14h11.4" />
    </>
  )}
  {slug === 'platemaking' && (
    /* 網版框 */
    <>
      <rect x="3" y="4" width="18" height="16" rx="1.5" />
      <path d="M3 9h18M3 15h18M9 4v16M15 4v16" />
    </>
  )}
  {slug === 'cab-381' && (
    /* 粉體罐。罐蓋壓扁、罐身加顆粒，才不會看成一把鎖 */
    <>
      <rect x="5" y="3" width="14" height="3.5" rx="1" />
      <path d="M6.5 6.5h11V19a2 2 0 0 1-2 2h-7a2 2 0 0 1-2-2z" />
      <path d="M10 11h.01M14 11h.01M12 14h.01M9.5 15.5h.01M14.5 15.5h.01" />
    </>
  )}
  {!['screen-inks', 'thinners-cleaners', 'platemaking', 'cab-381'].includes(slug) && (
    <rect x="4" y="4" width="16" height="16" rx="2" />
  )}
</svg>
