---
import CategoryIcon from './CategoryIcon.astro';
import { categories, productsOf, subcategoryHref } from '../data/site';

interface Props {
  activeCategory?: string;
  activeSubcategory?: string | null;
}
const { activeCategory, activeSubcategory } = Astro.props;
---

<nav class="cat-nav" aria-label="產品分類">
  <h2>產品分類</h2>
  <ul>
    {categories.map((cat) => (
      <li>
        <a
          class="cat-main"
          href={`/category/${cat.slug}/`}
          aria-current={cat.slug === activeCategory ? 'true' : undefined}
        >
          <CategoryIcon slug={cat.slug} />
          <span class="cat-label">{cat.name}</span>
          <span class="cat-count">{productsOf(cat.slug).length}</span>
        </a>
        {/*
          只展開目前所在的大分類。全部攤開是 33 條產品線、約 40 列，
          在製版資材頁面上得先捲過整串網印油墨才看得到自己在哪一區。
          收起來的分類點一下就進到它的頁面，那時才展開。
        */}
        {cat.slug === activeCategory && cat.children.length > 0 && (
          <ul>
            {cat.children.map((sub) => (
              <li>
                <a
                  href={subcategoryHref(cat.slug, sub.slug)}
                  class={sub.productCount === 0 ? 'empty' : undefined}
                  aria-current={sub.slug === activeSubcategory ? 'true' : undefined}
                  title={sub.productCount === 0 ? '此產品線尚未上架內容' : undefined}
                >
                  {sub.name}
                </a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
</nav>
