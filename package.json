    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@fontsource/noto-sans-tc": "^5.3.0",
    "playwright": "^1.63.0",
    "wrangler": "^4.135.0"
